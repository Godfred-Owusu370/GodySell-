rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'godfredowusu370@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidProduct(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 150 &&
             data.price is number && data.price > 0 &&
             data.category is string && data.category.size() <= 80 &&
             data.region is string && data.region.size() <= 50 &&
             data.sellerName is string && data.sellerName.size() <= 100 &&
             data.sellerPhone is string && data.sellerPhone.size() <= 35;
    }

    // Default deny for unmatched documents
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection testing endpoint
    match /test/{docId} {
      allow read, write: if true;
    }

    // Shared GodySell Marketplace Products Collection
    match /products/{productId} {
      // Anyone can browse and search published products nationwide
      allow read: if true;

      // Sellers can publish new products
      allow create: if isValidId(productId) && isValidProduct(request.resource.data);

      // Sellers can update or remove their listings, or admin
      allow update: if isValidId(productId) && isValidProduct(request.resource.data);
      allow delete: if isValidId(productId);
    }
  }
}
